{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*", "worker/**/*", "cloudflare.config.ts", "wrangler.config.ts"],
  "exclude": ["dist", "node_modules", ".cloudflare"]
}
